# Scratch files: probes, one-off reports and intermediate builds. They used to
# get committed by `git add -A` (once a 15MB OCR intermediate went in), so they
# are ignored by pattern rather than by memory.
_*
*.tmp
*.log

# Python
__pycache__/
*.pyc

# Per-page OCR results from tools/ocr_text_layer.py, keyed by page image hash so
# only pages whose picture changed get recognised again. Regenerable.
.ocr-cache/

# Draft outlines from tools/gen_toc.py: regenerable, and the checked-in toc-*.json
# stays the verified source. toc-review.md (the human-facing comparison) is tracked.
toc-*.proposed.json

# Local-only helpers: the Windows scheduled task runs start-server.bat from this
# folder, but the public repo does not need it (it also leaks local paths).
start-server.bat
start-server-hidden.vbs

# Local dev page for the flip-book library; not part of the site
stpageflip-demo.html

# OS noise
Thumbs.db
.DS_Store
desktop.ini

# Per-catalog search-index rows from tools/gen_pages.py, keyed by PDF hash.
.search-cache.json
